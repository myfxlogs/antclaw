# Dockerfile.backend - Go backend service image
# See: AntClaw-重构解决方案.md §2.3

FROM golang:1.23-alpine AS builder

ENV GOTOOLCHAIN=auto
WORKDIR /app

# Copy gen/go first (dependency)
COPY gen/go/ ./gen/go/

# Copy backend
COPY backend/go.mod backend/go.sum* ./backend/
RUN cd backend && go mod download 2>/dev/null || true

COPY backend/ ./backend/

# Build all binaries with version info from ldflags
ARG VERSION=0.1.0
ARG GIT_COMMIT=dev
ARG PROTO_VERSION=1.0.0
ARG MIN_CLIENT_VERSION=1.0.0
WORKDIR /app/backend
RUN go build -ldflags "\
  -X github.com/antclaw/antclaw/internal/adapter/rpc.Version=${VERSION} \
  -X github.com/antclaw/antclaw/internal/adapter/rpc.GitCommit=${GIT_COMMIT} \
  -X github.com/antclaw/antclaw/internal/adapter/rpc.ProtoVersion=${PROTO_VERSION} \
  -X github.com/antclaw/antclaw/internal/adapter/rpc.MinClientVersion=${MIN_CLIENT_VERSION}" \
  -o ../bin/antclaw-api ./cmd/antclaw-api
RUN go build -ldflags "\
  -X github.com/antclaw/antclaw/internal/adapter/rpc.Version=${VERSION} \
  -X github.com/antclaw/antclaw/internal/adapter/rpc.GitCommit=${GIT_COMMIT}" \
  -o ../bin/antclaw-worker ./cmd/antclaw-worker
RUN go build -ldflags "\
  -X github.com/antclaw/antclaw/internal/adapter/rpc.Version=${VERSION} \
  -X github.com/antclaw/antclaw/internal/adapter/rpc.GitCommit=${GIT_COMMIT}" \
  -o ../bin/antclaw-backtest-runner ./cmd/antclaw-backtest-runner
RUN go build -ldflags "\
  -X github.com/antclaw/antclaw/internal/adapter/rpc.Version=${VERSION} \
  -X github.com/antclaw/antclaw/internal/adapter/rpc.GitCommit=${GIT_COMMIT}" \
  -o ../bin/antclaw-cli ./cmd/antclaw-cli

# Final stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy binaries from builder
COPY --from=builder /app/bin/ /usr/local/bin/

# Default: run API server (override per service in docker-compose)
CMD ["antclaw-api"]
